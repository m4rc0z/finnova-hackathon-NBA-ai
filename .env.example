# LLM Provider Configuration (Swisscom Default)
LLM_PROVIDER=swisscom

# Swisscom Apertus API
SWISSCOM_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
SWISSCOM_MODEL=swiss-ai/Apertus-v1.5-70B
SWISSCOM_API_KEY=DEIN_SWISSCOM_API_KEY_HIER

# Hackathon Backend
BACKEND_BASE_URL=http://localhost:8000

