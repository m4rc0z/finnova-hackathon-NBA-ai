# OpenClaw package version used while building the image.
# Pin a release for reproducible deployments, for example: 2026.9.4
OPENCLAW_VERSION=latest

# Keep the default host binding local. Use 0.0.0.0 only with a firewall or
# reverse proxy in front of the Gateway.
OPENCLAW_BIND_ADDRESS=127.0.0.1
OPENCLAW_HOST_PORT=18789
OPENCLAW_GATEWAY_PORT=18789

# Replace this before starting the stack. Generate one with:
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token
OPENCLAW_LOG_LEVEL=info

# Add provider credentials only when needed. They stay in the local .env file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TELEGRAM_BOT_TOKEN=

# To run the image published by GitHub Actions instead of building locally:
# OPENCLAW_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
