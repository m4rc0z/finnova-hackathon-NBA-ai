# Swisscom OpenAI-compatible endpoint and model.
SWISSCOM_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
SWISSCOM_MODEL=swiss-ai/Apertus-v1.5-70B
# Put your real Swisscom API key here. Never commit .env.
SWISSCOM_API_KEY=replace-with-your-swisscom-api-key

# Logging
LOG_LEVEL=INFO
