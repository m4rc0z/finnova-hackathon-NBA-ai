# Stable Compose project name; keep it unchanged to retain the named volume.
COMPOSE_PROJECT_NAME=openclaw

# OpenClaw package version used while building the image.
# Pin a release for reproducible deployments, for example: 2026.9.4
OPENCLAW_VERSION=2026.9.4

# Keep the default host binding local. Use 0.0.0.0 only with a firewall or
# reverse proxy in front of the Gateway.
OPENCLAW_BIND_ADDRESS=127.0.0.1
OPENCLAW_HOST_PORT=18789
OPENCLAW_GATEWAY_PORT=18789

# Gateway token for the local Control UI. Generate one with:
# openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-token
OPENCLAW_LOG_LEVEL=info

# Swisscom OpenAI-compatible endpoint and model.
SWISSCOM_BASE_URL=https://api.swisscom.com/products/swiss-ai-weeks/apertus-1.5-70b/v1
SWISSCOM_MODEL=swiss-ai/Apertus-v1.5-70B
# Put your real Swisscom API key here. Never commit .env.
SWISSCOM_API_KEY=replace-with-your-swisscom-api-key

# To run the image published by GitHub Actions instead of building locally:
# OPENCLAW_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
